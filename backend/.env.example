# ==============================================================================
# DigiMitra Backend Configuration - Environment Variables Template
# ==============================================================================

# Application Settings
PROJECT_NAME="DigiMitra API"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a secure secret in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=digimitra-dev-insecure-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Connection
# SQLite for local testing without containers:
DATABASE_URL=sqlite+aiosqlite:///./digimitra.db
# MySQL for Docker Compose / Production:
# DATABASE_URL=mysql+aiomysql://digimitra_user:digimitra_secret_pass@localhost:3306/digimitra_db

# CORS Configuration (JSON array of strings or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Internationalization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","hi"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
