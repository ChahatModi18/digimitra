# ==============================================================================
# DigiMitra Global Environment Variables Template
# ==============================================================================

# Backend Settings
PROJECT_NAME="DigiMitra API"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & JWT Auth
SECRET_KEY=digimitra-dev-insecure-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Connection
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./digimitra.db
# Docker Compose MySQL:
# DATABASE_URL=mysql+aiomysql://digimitra_user:digimitra_secret_pass@localhost:3306/digimitra_db

# Frontend Settings
VITE_API_URL=/api/v1
