# ==============================================================================
# DigiMitra Global Environment Variables Template
# ==============================================================================

# Backend Settings
PROJECT_NAME="DigiMitra API"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & JWT Auth
# FOR DEVELOPMENT: The key below may be used for local testing only.
# FOR PRODUCTION: You MUST set a cryptographically secure random secret (min 32 chars).
# Example to generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Startup will fail fast in production (ENVIRONMENT=production) if SECRET_KEY is default or weak.
SECRET_KEY=digimitra-dev-insecure-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Database Connection
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./digimitra.db
# Docker Compose MySQL:
# DATABASE_URL=mysql+aiomysql://digimitra_user:digimitra_secret_pass@localhost:3306/digimitra_db

# Frontend Settings
VITE_API_URL=/api/v1
